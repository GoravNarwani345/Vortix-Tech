# ===== Database =====
DATABASE_URL="postgresql://user:password@localhost:5432/vortix_tech"

# ===== AI (Google Gemini) =====
GEMINI_API_KEY=""

# ===== Email (SMTP — Hostinger) =====
# Hostinger mail: smtp.hostinger.com:465 (SSL). Titan mail: smtp.titan.email:465
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
EMAIL_USER="info@thevortixtech.com"
EMAIL_PASS=""
# Optional "from" override (defaults to EMAIL_USER)
EMAIL_FROM="info@thevortixtech.com"
# Where contact form submissions are delivered (falls back to EMAIL_USER)
CONTACT_EMAIL="info@thevortixtech.com"

# ===== Admin auth =====
ADMIN_EMAIL="info@thevortixtech.com"
ADMIN_PASSWORD=""
# Secret used to sign the admin session cookie (generate a long random string)
ADMIN_SESSION_SECRET=""

# ===== Cron (daily auto-blog) =====
# Required. Pass as ?key=... or Authorization: Bearer <secret>
CRON_SECRET=""
