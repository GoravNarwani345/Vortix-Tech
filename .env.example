# ===== Database =====
DATABASE_URL="postgresql://user:password@localhost:5432/vortix_tech"

# ===== AI (Google Gemini) =====
GEMINI_API_KEY=""

# ===== AI (AgentRouter / OpenAI-Compatible) =====
# Optional: Use AgentRouter (deepseek-v4-flash is recommended first for lowest credits)
AGENTROUTER_API_KEY=""
AGENTROUTER_BASE_URL="https://agentrouter.org/v1"
AGENTROUTER_MODEL="deepseek-v4-flash"
AGENTROUTER_REASONING_EFFORT="medium"

# ===== AI Image Generation (StepFun / OpenAI-Compatible) =====
# API key for image generation (e.g. StepFun or gateway provider)
IMAGE_API_KEY=""
# Base URL for OpenAI-compatible image endpoint (defaults to https://api.hcnsec.cn/v1)
IMAGE_BASE_URL="https://api.hcnsec.cn/v1"
# Image model identifier (defaults to step-image-edit-2)
IMAGE_MODEL="step-image-edit-2"

# ===== Email =====
# Preferred: Resend (HTTPS/443, works when VPS blocks SMTP)
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend.
# Until verified, use: "Vortix Tech <onboarding@resend.dev>"
EMAIL_FROM="Vortix Tech <noreply@thevortixtech.com>"
# Where contact form submissions are delivered
CONTACT_EMAIL="info@thevortixtech.com"

# --- SMTP fallback (only used if RESEND_API_KEY is empty) ---
# Hostinger mail: smtp.hostinger.com:465 (SSL). Titan: smtp.titan.email:465
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
EMAIL_USER="info@thevortixtech.com"
EMAIL_PASS=""

# ===== Admin auth =====
ADMIN_EMAIL="info@thevortixtech.com"
ADMIN_PASSWORD=""
# Secret used to sign the admin session cookie (generate a long random string)
ADMIN_SESSION_SECRET=""

# ===== Cron (daily auto-blog) =====
# Required. Pass as ?key=... or Authorization: Bearer <secret>
CRON_SECRET=""
